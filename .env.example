# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=BeautySalonBooking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_in_production
MINIO_BUCKET=bookio-media

# ── Backend ───────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=your-super-secret-key-min-32-chars-change-in-production!!
JWT_ISSUER=BookVisit
JWT_AUDIENCE=BookVisitApp
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_ADDRESS=your-email@example.com
SMTP_FROM_NAME=BookVisit

# ── pgAdmin ────────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Frontend (baked into JS bundle at build time) ─────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=your-facebook-app-id
