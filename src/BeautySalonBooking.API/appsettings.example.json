{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=BeautySalonBooking;Username=postgres;Password=your_password"
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "PublicEndpoint": "http://localhost:9000",
    "AccessKey": "your_access_key",
    "SecretKey": "your_secret_key",
    "BucketName": "bookio-media"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Booking": {
    "TimezoneOffsetHours": 4
  },
  "Subdomain": {
    "MainDomains": ["localhost", "bookvisit.com"]
  },
  "OAuth": {
    "Google": {
      "ClientId": "your-client-id.apps.googleusercontent.com",
      "ClientSecret": "your-client-secret",
      "CallbackUrl": "https://localhost/api/auth/google/callback"
    }
  },
  "AllowedHosts": "*"
}
