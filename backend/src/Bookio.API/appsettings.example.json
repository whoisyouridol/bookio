{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=Bookio;Username=postgres;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET_MIN_32_CHARS_CHANGE_IN_PRODUCTION",
    "Issuer": "Bookio",
    "Audience": "BookioApp",
    "AccessTokenExpirationMinutes": 15
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "PublicEndpoint": "http://localhost:9000",
    "AccessKey": "YOUR_MINIO_ACCESS_KEY",
    "SecretKey": "YOUR_MINIO_SECRET_KEY",
    "BucketName": "bookio-media"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseSsl": true,
    "Username": "your-email@example.com",
    "Password": "YOUR_GOOGLE_APP_PASSWORD",
    "FromAddress": "your-email@example.com",
    "FromName": "Bookio"
  },
  "OAuth": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
      "CallbackUrl": "https://localhost/api/auth/google/callback"
    },
    "Facebook": {
      "AppId": "YOUR_FACEBOOK_APP_ID",
      "AppSecret": "YOUR_FACEBOOK_APP_SECRET",
      "CallbackUrl": "https://localhost/api/auth/facebook/callback"
    }
  },
  "SuperAdmins": [
    {
      "Email": "admin@yourdomain.com",
      "Password": "YOUR_ADMIN_PASSWORD",
      "FirstName": "Admin",
      "LastName": "User"
    }
  ],
  "Booking": {
    "TimezoneOffsetHours": 4
  },
  "Subdomain": {
    "MainDomains": [ "localhost", "bookio.com" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Otel": {
    "TempoEndpoint": "http://tempo:4317",
    "LokiEndpoint": "http://loki:3100/otlp/v1/logs"
  },
  "AllowedHosts": "*"
}
